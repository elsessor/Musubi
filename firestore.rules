rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function belongsToOrganization(orgId) {
      return signedIn() && userProfile().data.organizationId == orgId;
    }

    function isStudentLeader() {
      return signedIn() && userProfile().data.role == "Student Leader";
    }

    match /committees/{committeeId} {
      allow get, list: if belongsToOrganization(resource.data.orgId);

      allow create: if isStudentLeader()
        && request.resource.data.orgId == userProfile().data.organizationId
        && request.resource.data.headMemberUID == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.description is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          "orgId", "name", "headMemberUID", "description", "createdAt"
        ]);

      allow update, delete: if isStudentLeader()
        && belongsToOrganization(resource.data.orgId);
    }
  }
}
